<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetworkUtils 的联网检测会读 ConnectivityManager.activeNetwork / NetworkCapabilities，
         没有这个普通权限会抛 SecurityException（现在被 catch 成「当作有网」，检测形同虚设） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 安装/自更新：ActionView 打开 APK 也需要它，应用才能出现在「安装未知应用」白名单里 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 无障碍守护：Android 14+ 前台服务要声明 specialUse -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 后台保活：请求加入电池优化白名单（系统弹窗一键允许） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <permission-group
        android:name="com.churan.shizako.permission-group.API"
        android:description="@string/permission_group_description"
        android:icon="@drawable/ic_system_icon"
        android:label="@string/permission_group_label" />

    <permission
        android:name="com.churan.shizako.permission.MANAGER"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.churan.shizako.permission.MANAGER" />

    <!-- 「存储代理」能力标记（规格 F5）。真正的运行时校验是 ShizukuConfig 里的
         FLAG_STORAGE_PROXY 位（管理器「第三方调用」页单独勾选），系统是否授予这个
         权限不参与判定 —— 这里声明它，是给第三方应用一个可读的能力名/说明，避免
         文档里只有一句「去通行证里打开」。
         用 dangerous 而不是 signature：signature 会让第三方清单里的 uses-permission
         直接被忽略，反而看不出「它申请了这个能力」。 -->
    <permission
        android:name="com.churan.shizako.permission.STORAGE_PROXY"
        android:description="@string/storage_permission_description"
        android:icon="@drawable/ic_system_icon"
        android:label="@string/storage_permission_label"
        android:permissionGroup="com.churan.shizako.permission-group.API"
        android:protectionLevel="dangerous" />

    <permission
        android:name="com.churan.shizako.permission.API_V23"
        android:description="@string/permission_description"
        android:icon="@drawable/ic_system_icon"
        android:label="@string/permission_label"
        android:permissionGroup="com.churan.shizako.permission-group.API"
        android:protectionLevel="dangerous" />
    <!-- strip the uses-permission merged in from the Shizuku-API library aar -->
    <uses-permission
        android:name="moe.shizuku.manager.permission.API_V23"
        tools:node="remove" />

    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:name=".ShizukuApplication"
        android:allowBackup="true"
        android:autoRevokePermissions="allowed"
        android:banner="@drawable/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:directBootAware="true"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning"
        tools:remove="android:appComponentFactory"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:banner="@mipmap/banner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

                <!-- 2023.08.03: Google play enforces that apps with LEANBACK_LAUNCHER Activity must be uploaded with App Bundle format, -->
                <!-- and possibly additional review steps. To avoid problems, remove it temporarily. -->
                <!--<category android:name="android.intent.category.LEANBACK_LAUNCHER" />-->
            </intent-filter>
            <!-- 系统设置「应用偏好」入口（原 SettingsActivity 的 filter，现为设置 Tab） -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
            </intent-filter>
        </activity>
        <activity
            android:name=".setup.SetupActivity"
            android:exported="false"
            android:label="@string/app_name" />
        <activity
            android:name=".setup.UpdateWelcomeActivity"
            android:exported="false"
            android:label="@string/app_name" />
        <activity
            android:name=".update.InstallApkActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".authorization.RequestPermissionActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="${applicationId}.intent.action.REQUEST_PERMISSION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 权限模板 / 批次历史（F6-F8）：应用管理页右上角「权限模板」进入 -->
        <activity
            android:name=".batch.TemplateListActivity"
            android:exported="false"
            android:label="@string/template_title" />
        <activity
            android:name=".batch.TemplateEditActivity"
            android:exported="false"
            android:label="@string/template_edit" />
        <activity
            android:name=".legacy.ShellRequestHandlerActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="rikka.shizuku.intent.action.REQUEST_BINDER" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".legacy.LegacyIsNotSupportedActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.churan.shizako.permission.API"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="${applicationId}.intent.action.REQUEST_AUTHORIZATION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".dhizuku.DhizukuPermissionActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/GrantPermissions">
            <intent-filter>
                <action android:name="${applicationId}.action.REQUEST_DHIZUKU_PERMISSION" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- apk / apk1 / apk.1「用其他应用打开」入口。
             微信、QQ 收到安装包后会存成 xxx.apk.1（或 xxx.apk1）躲避系统安装器，
             这里注册对应的 VIEW/SEND，用户在微信里选「用其他应用打开 → Shizako」
             就能无感安装（Shizuku 在跑时走 pm install，不弹系统安装器）。 -->
        <activity
            android:name=".installer.ApkInstallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/apk1_installer_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- content://：微信/QQ 一般用 application/octet-stream 发 apk.1 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <!-- file://：路径以 apk / apk1 / apk.1 结尾的文件管理器 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.apk" />
                <data android:pathPattern=".*\\.apk1" />
                <data android:pathPattern=".*\\.apk\\.1" />
            </intent-filter>
            <!-- 文件管理器里「分享到 Shizako」也接 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!-- 外部应用请求静默安装时的确认框（规格 F2）。只在需要问用户时被拉起，
             本身不做任何安装动作，所以 exported=false（只有本应用的 ApkInstallActivity 会起它）。 -->
        <activity
            android:name=".installer.InstallConfirmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/GrantPermissions" />

        <!-- 设置 →「安装」的三个二级页。都不导出：批量队列只能由本应用 UI 启动 -->
        <activity
            android:name=".installer.TrustedInstallersActivity"
            android:exported="false"
            android:label="@string/installer_trust_title" />
        <activity
            android:name=".installer.BatchInstallActivity"
            android:exported="false"
            android:label="@string/installer_batch_title" />
        <activity
            android:name=".installer.InstallHistoryActivity"
            android:exported="false"
            android:label="@string/installer_history_title" />

        <!-- 应用数据备份/恢复（F3/F4/F5）：应用管理页右上角「应用数据备份与恢复」进入。
             不导出：SAF 目录由用户当场选择，队列也只由本应用 UI 启动。
             configChanges 是有意为之：这一页的「已选应用 / 已选目录 / 当前页签 / 操作中状态」
             都挂在 Activity 的 Compose state 上，默认旋转会重建 Activity 并把这些选择清空；
             这页没有需要随配置重新加载的资源（纯 Compose + 运行时数据），自己处理旋转即可。 -->
        <activity
            android:name=".storage.DataBackupActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:label="@string/storage_title" />

        <service
            android:name=".adb.AdbPairingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <service
            android:name=".tile.ServiceTile"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_bolt_24dp"
            android:label="@string/tile_service_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".tile.WirelessAdbTile"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_wadb_24"
            android:label="@string/tile_wireless_adb_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".watchdog.WatchdogService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep_watchdog_and_shizuku_alive" />
        </service>

        <receiver
            android:name=".watchdog.WatchdogRestartReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 「用 ADB 保活」跳板（仅兜底）：Activity 会抢焦点，正常路径已改为下面的 Service。
             两个组件都必须 exported —— shell 小看门靠 `am` 拉起它们。但裸着 exported 等于
             任何第三方应用都能反复拉起本进程（耗电/前台服务刷屏），所以用
             INTERACT_ACROSS_USERS_FULL 收口：这个权限 shell（com.android.shell）有、普通应用拿不到，
             root（uid 0）本来就不受组件权限限制，保活的两条链路都不受影响。
             项目自己的 ShizukuManagerProvider 用的也是同一个权限，属于既有约定。 -->
        <activity
            android:name=".watchdog.KeepAliveTrampolineActivity"
            android:enabled="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 键盘安全入口：shell 小看门用 `am start-service` 拉活/唤醒（无界面、不抢焦点、不缩键盘） -->
        <service
            android:name=".watchdog.KeepAliveBridgeService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <receiver
            android:name=".receiver.BootCompleteReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.ShizukuReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="rikka.shizuku.intent.action.REQUEST_BINDER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.TaskerReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.churan.shizako.action.START" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.STOP" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.START_ROOT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.START_ADB" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.ACTIVATE_DHIZUKU" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.QUERY_STATUS" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.NOTIFY_INSTALL" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.churan.shizako.action.DOWNLOAD_UPDATE" />
            </intent-filter>
        </receiver>

        <!-- ══════════ 自动化：EXEC_SHELL 特权命令执行（F2） ══════════ -->
        <!-- exported=true 是必需的（Tasker/MacroDroid 是别的应用，且广播只能显式组件投递）。
             真正的门禁在接收器里：显式组件 + 令牌 + 绑定包签名，三重校验缺一不可。
             这里保留 intent-filter 是为了让「隐式调用」也能进入 onReceive 被记进日志，
             而不是被系统静默丢弃 —— 排查调用方写错 action 时差别很大。 -->
        <receiver
            android:name=".automation.ExecShellReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.churan.shizako.action.EXEC_SHELL" />
            </intent-filter>
        </receiver>

        <!-- 命令执行宿主：前台服务，否则 300s 的超时会撞广播接收器的 ANR 上限。
             类型用 specialUse（和看门狗/无障碍一致），避免 dataSync 在 Android 15 的时长配额。 -->
        <service
            android:name=".automation.AutomationExecService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="automation_shell_command" />
        </service>

        <receiver
            android:name=".update.UpdateCheckReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.churan.shizako.action.UPDATE_CHECK" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- 周期检查更新：JobScheduler 任务（不再用会唤醒 Doze 的 AlarmManager 闹钟） -->
        <service
            android:name=".update.UpdateCheckJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 开机自动关掉 USB 调试（ADB 启过 Shizuku 之后把口子关上，更安全） -->
        <receiver
            android:name=".receiver.AutoDisableUsbDebuggingReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".ShizukuManagerProvider"
            android:authorities="${compatAuthority}"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ══════════ ADB Modules（照搬 Shevery）══════════ -->
        <!-- 模块本地 WebUI（只有模块目录里的页面，路径穿越会被拒） -->
        <activity
            android:name=".module.ModuleWebViewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/modules_title" />

        <!-- ══════════ 无障碍管理器（照搬 Shevery）══════════ -->
        <activity
            android:name=".accessibility.AccessibilityManagerActivity"
            android:exported="false"
            android:label="@string/accessibility_manager" />
        <service
            android:name=".accessibility.AccessibilityDaemonService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep_accessibility_service_alive" />
        </service>
        <receiver
            android:name=".accessibility.AccessibilityBootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- ══════════ Shizuku Connectors（实验室功能，默认关闭）══════════
             开着时第三方「激活器」可以 query 出启动本地 Shizuku server 的命令；
             关着时返回空结果。 -->
        <provider
            android:name=".connector.ShizukuConnectorProvider"
            android:authorities="${applicationId}.connector"
            android:enabled="true"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update_file_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Dhizuku（Device Owner）集成：Dhizuku-API 应用通过该 authority
             发现并连接 Shizako，authority 由客户端按「owner 包名 + 后缀」动态拼接。 -->
        <provider
            android:name=".dhizuku.DhizukuProvider"
            android:authorities="${applicationId}.dhizuku_server.provider"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true" />

        <receiver
            android:name=".dhizuku.DhizukuAdminReceiver"
            android:description="@string/dhizuku_device_owner_desc"
            android:exported="true"
            android:label="@string/dhizuku_device_owner_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/dhizuku_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>