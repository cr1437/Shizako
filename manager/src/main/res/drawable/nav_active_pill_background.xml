<?xml version="1.0" encoding="utf-8"?>
<!-- 选中 tab 的滑动胶囊（Figma 设计稿：玻璃胶囊包裹选中 tab 的图标+标签）：
     1) 填充 nav_pill_fill —— 主题色 18%（夜间 26%）透明薄纱，透出 BlurView
        模糊形成亚克力感，选中态清晰可辨；
     2) 1dp 同色细描边 nav_pill_stroke，勾出玻璃胶囊边缘；
     3) 圆角 100dp 超出半高即全圆胶囊（Figma cornerRadius=100）。
     宽度在运行时对齐选中 tab（等分恒宽），滑动动画由
     MainActivity.setupNavPill() 驱动（ValueAnimator，无弹簧）。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="@color/nav_pill_fill" />
    <stroke
        android:width="@dimen/ksu_nav_pill_stroke_width"
        android:color="@color/nav_pill_stroke" />
</shape>
