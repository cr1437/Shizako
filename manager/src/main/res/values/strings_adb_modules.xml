    <string name="adb_modules_empty_title">No modules installed</string>
    <string name="adb_modules_empty_summary">Any ZIP with a module.prop in its root is a module. Pick one below and it is unpacked into files/adb_modules.</string>
    <string name="adb_modules_howto_title">How to build a module</string>
    <string name="adb_modules_step_1_title">module.prop</string>
    <string name="adb_modules_step_1_body">Metadata at the ZIP root: id, name, version, versionCode, author, description. Optional keys: banner, webui, action, usesShellBridge.</string>
    <string name="adb_modules_step_1_hint">id must start with a letter and contain 2 to 64 characters of A-Z a-z 0-9 . _ -</string>
    <string name="adb_modules_step_2_title">action.sh / service.sh</string>
    <string name="adb_modules_step_2_body">action.sh runs when the Action button is tapped. service.sh runs when the module is enabled and both the service and background policies allow it.</string>
    <string name="adb_modules_step_2_hint">Both run as shell or root, with MODDIR pointing at the module directory.</string>
    <string name="adb_modules_step_3_title">webui/index.html</string>
    <string name="adb_modules_step_3_body">Put an index.html into webui/ and the WebUI button opens it in a local WebView.</string>
    <string name="adb_modules_layout_title">ZIP layout</string>
    <string name="adb_modules_layout_body">my-module/\n  module.prop\n  action.sh\n  service.sh\n  webui/index.html\n  banner.png</string>
    <string name="adb_modules_env_title">Environment variables</string>
    <string name="adb_modules_env_body">MODDIR=files/adb_modules/my-module\nMODPATH=$MODDIR\nSHIZUKU_MODULE_ID=my-module\nSHIZUKU_MODULE_MODE=safe\nSHIZUKU_MODULE_TRUSTED=0\nSHIZUKU_MODULE_BACKGROUND=0\nARCH=arm64-v8a</string>
    <string name="adb_modules_hard_limits">Hard limits: 2048 entries and 200 MB per ZIP, scripts up to 256 KB and 120 s runtime, only the last 64 KB of output is kept.</string>

