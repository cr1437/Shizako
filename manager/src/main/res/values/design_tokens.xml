<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         KernelSU 风格统一设计 Token（唯一事实来源）
         所有页面/卡片/导航的尺寸一律引用此处，禁止各自硬编码，
         保证整套界面协调统一、无旧尺寸残留。
         ============================================================ -->

    <!-- 页面内容左右边距 -->
    <dimen name="ksu_page_margin">16dp</dimen>
    <!-- 卡片之间的垂直间距 -->
    <dimen name="ksu_card_spacing">12dp</dimen>
    <!-- 卡片统一内边距 -->
    <dimen name="ksu_card_padding">16dp</dimen>
    <!-- 大卡内边距（KernelSU 状态卡 / 信息卡参照值为 24dp） -->
    <dimen name="ksu_card_padding_large">24dp</dimen>
    <!-- 信息卡行间距（KernelSU InfoCard 参照值） -->
    <dimen name="ksu_info_row_spacing">24dp</dimen>

    <!-- 亚克力悬浮底部导航（Figma「Home - Bottom」设计稿） -->
    <dimen name="ksu_nav_margin_horizontal">16dp</dimen>
    <dimen name="ksu_nav_margin_bottom">16dp</dimen>
    <!-- 底栏圆角：100dp 超出半高即全圆胶囊（Figma cornerRadius=100） -->
    <dimen name="ksu_nav_corner_radius">100dp</dimen>
    <!-- 底栏高度（Figma 59dp）：24dp 图标 + 10sp 标签 + 内边距 -->
    <dimen name="ksu_nav_height">59dp</dimen>
    <!-- 底栏内边距：选中胶囊与 tab 内容都相对它排布（Figma 6dp） -->
    <dimen name="ksu_nav_inner_padding">6dp</dimen>
    <!-- 选中胶囊高度（Figma 47dp = 59 - 2×6）：包裹选中 tab 的图标+标签，
         宽度运行时对齐选中 tab（等分恒宽），切换 Tab 时水平滑过去 -->
    <dimen name="ksu_nav_tab_capsule_height">47dp</dimen>
    <!-- tab 图标尺寸（Figma 24dp） -->
    <dimen name="ksu_nav_tab_icon_size">24dp</dimen>
    <!-- 选中胶囊同色细描边宽度 -->
    <dimen name="ksu_nav_pill_stroke_width">1dp</dimen>

    <!-- 内容底部预留：导航高(59) + 底部间距(16) + 手势条(至 32) + 悬浮余量，
         厚手势条机型上也能完整露出列表末行，不被亚克力导航遮挡 -->
    <dimen name="ksu_content_bottom_padding">115dp</dimen>
</resources>
