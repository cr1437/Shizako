<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.Light" />

    <style name="Card">
        <item name="android:duplicateParentState">true</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">20dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="Card.Light" />

    <style name="CardButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="iconPadding">12dp</item>
    </style>

    <style name="CardTitle">
        <item name="android:textAppearance">?textAppearanceBodyLarge</item>
        <!-- 不用 ?android:textColorPrimary/Secondary（继承链上可能被调成半透明，深色下就发灰看不清），
             直接用 M3 语义色：正文 onSurface、次要 onSurfaceVariant，两种模式下都是实色。 -->
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">1sp</item>
    </style>

    <style name="CardSummary">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">4sp</item>
    </style>

    <style name="CardContent">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="CardIcon">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/shape_circle_icon_background</item>
        <item name="android:tint">?colorOnPrimaryContainer</item>
        <item name="android:tintMode">src_in</item>
        <item name="android:backgroundTint">?colorPrimaryContainer</item>
        <item name="android:backgroundTintMode">src_in</item>
    </style>

    <style name="GrantPermissions" parent="@style/AppTheme">
        <item name="android:colorBackground">?colorBackgroundFloating</item>
        <item name="android:colorBackgroundCacheHint">@null</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="TerminalTutorialText">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="FilledCard" parent="@style/Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">-4dp</item>
        <item name="android:layout_marginEnd">-4dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
        <item name="contentPaddingStart">24dp</item>
        <item name="contentPaddingEnd">24dp</item>
        <item name="contentPaddingLeft">24dp</item>
        <item name="contentPaddingRight">24dp</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
        <item name="cardBackgroundColor">?colorSecondaryContainer</item>
    </style>

    <style name="GrantPermissionsButtons">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?textColorOnPrimaryContainer</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GrantPermissionsButtons.Top">
        <item name="android:background">@drawable/grant_permissions_buttons_top</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="GrantPermissionsButtons.Buttom">
        <item name="android:background">@drawable/grant_permissions_buttons_bottom</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <!-- ==================== KernelSU 统一设计系统 ==================== -->

    <!-- 形状：M3E（默认）大圆角 -->
    <style name="ShapeAppearance.Ksu.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearance.Ksu.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- 形状：Miuix 中等圆角（小米风） -->
    <style name="ShapeAppearance.Ksu.Miuix.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.Ksu.Miuix.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- 统一卡片（M3E）：Filled 容器色，圆角跟随主题 shapeAppearanceMediumComponent。
         注意：不在此处设 contentPadding——内边距由各布局按 Token 自行控制，
         避免与内容内边距叠加成双倍间距。 -->
    <style name="Widget.Ksu.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?colorSurfaceContainer</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 统一卡片（Miuix）：分组卡片，圆角由 Miuix 形状决定，底色用更亮分组背景 -->
    <style name="Widget.Ksu.Card.Miuix" parent="Widget.Ksu.Card">
        <item name="cardBackgroundColor">?ksuSectionBackground</item>
    </style>

    <!-- ══════════ 亚克力卡片 ══════════
         半透明亚克力底（白 50%）+ 悬浮阴影 + 噪点纹理，**没有边框**。
         玻璃风格下由 ThemeOverlay.Glass 把 ?ksuCardStyle 指到这来，
         所以所有走这套样式的卡片（首页状态卡 / 信息卡 / 激活卡容器 / 设置分组）一起换。 -->
    <style name="Widget.Ksu.Card.Glass" parent="Widget.Ksu.Card">
        <item name="cardBackgroundColor">@color/glass_card_fill_top</item>
        <!-- 边框全去掉：那圈 0.8dp 灰线是败笔 -->
        <item name="strokeWidth">0dp</item>
        <!-- 不要悬浮阴影 -->
        <item name="cardElevation">0dp</item>
        <item name="rippleColor">?colorPrimary</item>
        <!-- 噪点纹理（白/黑微点 alpha≈0.03，平铺） -->
        <item name="android:foreground">@drawable/acrylic_noise_tile</item>
    </style>

    <!-- 玻璃卡 · 自定义背景偏暗版：填充换成淡白罩（浅色主题配夜景照片时用）。
         由 ThemeOverlay.Glass.OnDarkBackground 覆盖 ?ksuCardStyle 指过来。
         判断在 AppActivity 里做：读背景图平均亮度 → 暗就叠这层。 -->
    <style name="Widget.Ksu.Card.Glass.OnDarkBackground" parent="Widget.Ksu.Card.Glass">
        <item name="cardBackgroundColor">@color/glass_card_fill_top_dark_bg</item>
    </style>

    <style name="Widget.Ksu.Button.Outlined.Glass.OnDarkBackground" parent="Widget.Ksu.Button.Outlined.Glass">
        <item name="backgroundTint">@color/glass_card_fill_top_dark_bg</item>
    </style>

    <!-- ══════════ 玻璃风格按钮 ══════════
         对应 Compose 侧 HintPrimaryButton / HintSecondaryButton 的玻璃版本：
         主按钮 = 强调色实心胶囊 + 一圈浅色折射边；次按钮 = 半透明玻璃胶囊 + 强调色文字。
         由 ThemeOverlay.Glass 覆盖 ?materialButtonStyle / ?materialButtonOutlinedStyle /
         ?materialButtonTextStyle，所以布局里只要用主题属性（而不是写死的 @style/Widget.Material3.Button.*）
         就会跟着风格走。 -->

    <style name="Widget.Ksu.Button.Glass" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
        <item name="strokeWidth">0.8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="rippleColor">?colorOnPrimary</item>
    </style>

    <style name="Widget.Ksu.Button.Outlined.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/glass_card_fill_top</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
        <item name="strokeWidth">0.8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="Widget.Ksu.Button.Text.Glass" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <!-- ══════════ 强调动作按钮（?ksuActionButtonStyle）══════════
         首页「开始激活」/ 应用页「去激活」/ 引导页底部按钮统一用这个：
         MD3 = 标准 M3 实心按钮；玻璃 = 半透明玻璃底 + 强调色文字（和卡片同一套 token）。
         以前这些按钮直接吃主题的 materialButtonStyle，玻璃风格下是实心主色块，
         跟旁边的玻璃卡不是一套东西。 -->
    <style name="Widget.Ksu.Button.Primary" parent="Widget.Material3.Button" />

    <style name="Widget.Ksu.Button.Primary.Glass" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/glass_button_fill</item>
        <item name="strokeColor">@color/glass_card_stroke</item>
        <item name="strokeWidth">0.8dp</item>
        <item name="android:textColor">?attr/appColorPrimary</item>
        <item name="iconTint">?attr/appColorPrimary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <!-- ══════════ 分段切换条（?ksuSegmentedStyle）══════════
         应用页顶部「Shizako 授权 / Dhizuku 授权」两个 Tab。
         MD3 = 次级容器胶囊底；玻璃 = 整块玻璃底 + 强调色指示器。
         应用页顶部已改用 Compose 滑块（AppsFragment.setupSegmentedHeader：玻璃 = GlassOptionSlider，
         MD3 = M3 分段按钮，与设置里「界面风格」同款）。本样式与配套 drawable 暂时保留、当前无引用。 -->
    <style name="Widget.Ksu.TabLayout" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_segmented_md3</item>
        <item name="tabIndicator">@drawable/bg_segmented_indicator_md3</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabTextColor">@color/segmented_tab_text_color</item>
        <item name="tabSelectedTextColor">@color/segmented_tab_selected</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabMaxWidth">10000dp</item>
    </style>

    <style name="Widget.Ksu.TabLayout.Glass" parent="Widget.Material3.TabLayout">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="tabIndicator">@drawable/bg_segmented_indicator_glass</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabTextColor">@color/segmented_tab_text_color</item>
        <item name="tabSelectedTextColor">@color/segmented_tab_selected</item>
        <item name="tabRippleColor">@null</item>
        <item name="tabMinWidth">0dp</item>
        <item name="tabMaxWidth">10000dp</item>
    </style>

    <!-- 引导页每步的卡片容器（?ksuSetupCardStyle）：
         MD3 = 标准填充卡；玻璃 = 玻璃卡（ThemeOverlay.Glass 里指向 Widget.Ksu.Card.Glass）。 -->
    <style name="Widget.Ksu.Card.Setup" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?colorSurfaceContainer</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 底栏 tab 标签（Figma「Home - Bottom」设计稿：10sp） -->
    <style name="TextAppearance.Ksu.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
    </style>

    <!-- ══════════ 顶部标题（沉浸式：透明标题栏 + 壁纸透上来）══════════
         纯白 + 淡淡阴影，配 appbar_scrim 渐变遮罩，任何壁纸上都清晰。 -->
    <style name="TextAppearance.Ksu.AppBarTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/appbar_title</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="TextAppearance.Ksu.AppBarTitle.Collapsed" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/appbar_title</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">4</item>
    </style>
</resources>