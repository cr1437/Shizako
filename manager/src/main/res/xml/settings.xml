<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="startup"
        android:title="@string/settings_startup">

        <rikka.material.preference.MaterialSwitchPreference
            android:key="start_on_boot"
            android:summary="@string/settings_start_on_boot_summary"
            android:title="@string/settings_start_on_boot" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_language">

        <rikka.preference.SimpleMenuPreference
            android:defaultValue="SYSTEM"
            android:key="language"
            android:summary="%s"
            android:title="@string/settings_language" />

        <Preference
            style="?preferenceInformationStyle"
            android:key="translation_contributors"
            android:title="@string/settings_translation_contributors" />

        <Preference
            android:key="translation"
            android:title="@string/settings_translation" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="user_interface"
        android:title="@string/settings_user_interface">

        <moe.shizuku.manager.settings.StringSimpleMenuPreference
            android:defaultValue="glass"
            android:entries="@array/ui_style_names"
            android:entryValues="@array/ui_style_values"
            android:key="ui_style"
            android:summary="%s"
            android:title="@string/settings_ui_style" />

        <moe.shizuku.manager.settings.IntegerSimpleMenuPreference
            android:entries="@array/night_mode"
            android:entryValues="@array/night_mode_value"
            android:key="night_mode"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="black_night_theme"
            android:summary="@string/settings_black_night_theme_summary"
            android:title="@string/settings_black_night_theme" />

        <rikka.material.preference.MaterialSwitchPreference
            android:key="use_system_color"
            android:title="@string/settings_use_system_color" />

        <moe.shizuku.manager.settings.StringSimpleMenuPreference
            android:entries="@array/theme_color_names"
            android:entryValues="@array/theme_color_values"
            android:key="theme_color"
            android:summary="%s"
            android:title="@string/settings_theme_color" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:key="show_logs_tab"
            android:summary="@string/settings_show_logs_tab_summary"
            android:title="@string/settings_show_logs_tab" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:key="high_refresh_rate"
            android:summary="@string/settings_high_refresh_rate_summary"
            android:title="@string/settings_high_refresh_rate" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_stability">

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="false"
            android:key="watchdog_enabled"
            android:summary="@string/settings_watchdog_summary"
            android:title="@string/settings_watchdog" />

        <rikka.material.preference.MaterialSwitchPreference
            android:defaultValue="true"
            android:key="auto_update"
            android:summary="@string/settings_auto_update_summary"
            android:title="@string/settings_auto_update" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_debug">

        <Preference
            android:key="check_update"
            android:summary="@string/settings_check_update_summary"
            android:title="@string/settings_check_update" />

        <Preference
            android:key="crash_logs"
            android:summary="@string/settings_crash_logs_summary"
            android:title="@string/settings_crash_logs" />

        <Preference
            android:key="api_log"
            android:summary="@string/settings_api_log_summary"
            android:title="@string/settings_api_log" />

    </PreferenceCategory>

</PreferenceScreen>