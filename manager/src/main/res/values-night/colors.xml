    <!-- 亚克力悬浮导航磨砂罩层（夜间）：暗色半透明，保证图标文字可读 -->
    <color name="nav_frost_scrim">#B3171B21</color>

    <!-- One-click activation, dark variants: lighter tones for dark surfaces. -->
    <color name="activation_status_active">#81C784</color>
    <color name="activation_status_inactive">#E57373</color>
    <color name="activation_status_unknown">#B0B0B0</color>
    <color name="activation_output_success">#81C784</color>
    <color name="activation_output_error">#E57373</color>
</resources>
