<?xml version="1.0" encoding="utf-8"?>
<!-- KernelSU 风格亚克力悬浮底部导航（纯图标紧凑版）：
     BlurView 实时模糊其下方的滚动内容（参考 KernelSU-Next 的 haze 玻璃底栏），
     叠加半透明磨砂罩层 nav_frost_scrim，圆角胶囊轮廓由 nav_capsule_background
     提供（clipToOutline 把模糊裁成胶囊形）。内部 BottomNavigationView 背景透明，
     完整复用 menu / 选中态 / 徽标 / removeItem 逻辑。
     导航栏为纯图标模式：labelVisibilityMode=unlabeled 去掉文字说明，仅保留图标
     （无障碍朗读仍使用 menu 中的 title）；高度收拢为 ksu_nav_height(48dp)，
     并同步覆盖 Material3 默认的 minHeight(80dp)，否则固定高度不生效。
     模糊源（BlurTarget）与 setupWith 在 MainActivity 中接线；
     底部避让手势条由 MainActivity.applyNavCapsuleInsets 动态加 margin。
     注意：必须用具体的 BottomNavigationView——抽象父类 NavigationBarView 没有
     (Context, AttributeSet) 两参构造器，XML 无法实例化（会导致 NoSuchMethodException）。 -->
<moe.shizuku.blurview.BlurView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_blur"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ksu_nav_margin_horizontal"
    android:layout_marginEnd="@dimen/ksu_nav_margin_horizontal"
    android:layout_marginBottom="@dimen/ksu_nav_margin_bottom"
    android:background="@drawable/nav_capsule_background"
    android:clipToOutline="true"
    android:elevation="4dp"
    app:blurOverlayColor="@color/nav_frost_scrim">

    <!-- 选中项共享滑动 pill（KernelSU-Next 果冻指示器）：声明在 BottomNavigationView
         之前（FrameLayout z 序靠后），垫在图标下方；初始 invisible，由
         MainActivity.setupNavPill() 完成首次定位后显示，避免在 x=0 处闪现。 -->
    <View
        android:id="@+id/nav_active_pill"
        android:layout_width="@dimen/ksu_nav_pill_width"
        android:layout_height="@dimen/ksu_nav_pill_height"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/nav_active_pill_background"
        android:visibility="invisible" />

    <!-- itemActiveIndicatorStyle=@null：关闭 M3 每项各自的静态指示器，
         避免与共享滑动 pill 叠加成双重高亮。
         （注意：Material 无 itemActiveIndicatorEnabled 布尔属性，用置空样式实现。） -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ksu_nav_height"
        android:minHeight="@dimen/ksu_nav_height"
        android:background="@android:color/transparent"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="@color/nav_icon_tint"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/navigation_menu" />
</moe.shizuku.blurview.BlurView>
