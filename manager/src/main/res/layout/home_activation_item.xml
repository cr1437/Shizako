<?xml version="1.0" encoding="utf-8"?>
<!-- 一站式激活入口卡（KernelSU / Shizuku 风格：首页只留一个入口）。
     首页不再铺开 4 种激活方式的按钮 —— 那些都在「一站式激活」详细页里，
     本卡只显示当前状态 + 一个「开始激活」按钮跳过去。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="?homeCardStyle"
    android:orientation="vertical">

    <TextView
        style="@style/CardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_activation_hub_title" />

    <TextView
        android:id="@+id/activation_hub_desc"
        style="@style/CardSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_activation_hub_desc" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/activation_action_button"
        style="?attr/ksuActionButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/activation_hub_action_open" />

</LinearLayout>
