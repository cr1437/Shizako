<?xml version="1.0" encoding="utf-8"?>
<!--
  图片卡片：FrameLayout 三层叠放
    ① 底层 ImageView —— 铺满、centerCrop（裁剪后的背景图，保持原始比例不变形）
    ② 中层 View      —— 底部渐变遮罩（透明 → 黑 70%），只压住图片下缘
    ③ 顶层 LinearLayout —— 标题 + 副标题，固定贴底、纯白字
  叠放顺序就是 View 的声明顺序：后声明的画在上面。
  动态换图只动 ①（imageView.setImageBitmap），②③ 完全不受影响。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/image_card"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="16dp"
    android:background="@drawable/card_image_container"
    android:clipToOutline="true"
    android:importantForAccessibility="no">

    <!-- ① 背景图：centerCrop = 居中裁剪铺满，永远不拉伸变形 -->
    <ImageView
        android:id="@+id/image_card_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        tools:src="@mipmap/ic_launcher" />

    <!-- ② 底部渐变遮罩：只负责让文字可读，本身不显示任何图片 -->
    <View
        android:id="@+id/image_card_scrim"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/card_scrim_bottom"
        android:importantForAccessibility="no" />

    <!-- ③ 文字层：贴底，白色固定，带 padding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/image_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="主人的头像" />

        <TextView
            android:id="@+id/image_card_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            tools:text="裁剪后的背景图 · 副标题" />
    </LinearLayout>

</FrameLayout>
