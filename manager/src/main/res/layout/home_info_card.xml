<?xml version="1.0" encoding="utf-8"?>
<!-- KernelSU 风格信息卡（参照 KernelSU Home.kt InfoCard）：
     单张卡片内纵向排列 label(bodyLarge) + value(bodyMedium) 信息行，
     24dp 内边距 / 24dp 行距，右下角「复制」按钮一键复制全部信息。
     卡片样式跟随 ?ksuCardStyle（M3E/Miuix 自动切换圆角与底色）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?ksuCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ksu_card_padding_large"
        android:paddingTop="@dimen/ksu_card_padding_large"
        android:paddingEnd="@dimen/ksu_card_padding_large"
        android:paddingBottom="@dimen/ksu_card_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_shizako"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="zako2.11" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ksu_info_row_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_info_android"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="16 (API 36)" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ksu_info_row_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_info_abi"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_abi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="arm64-v8a" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ksu_info_row_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_info_service"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Running · adb" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ksu_info_row_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_info_dhizuku"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_dhizuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="Activated" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ksu_info_row_spacing"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_info_apps"
                android:textAppearance="?textAppearanceBodyLarge"
                android:textColor="?colorOnSurface" />

            <TextView
                android:id="@+id/value_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSurfaceVariant"
                tools:text="3" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/info_copy"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/ksu_card_padding"
            android:text="@string/home_info_copy" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
