<?xml version="1.0" encoding="utf-8"?>
<!-- KernelSU 风格服务状态主卡（参照 KernelSU Home.kt StatusCard）：
     运行中 = secondaryContainer  tonal 容器，未运行 = errorContainer；
     图标 + 标题(titleMedium) + 副标题(bodyMedium)，24dp 内边距、20dp 图文间距。
     容器/文字颜色随服务状态在 ServerStatusViewHolder 中切换，
     圆角跟随主题（M3E 28dp / Miuix 20dp）。 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?ksuCardStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?colorSecondaryContainer"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ksu_card_padding_large">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_server_error_24dp"
            app:tint="?colorOnSecondaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@android:id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?textAppearanceTitleMedium"
                android:textColor="?colorOnSecondaryContainer"
                tools:text="Shizako 正在运行" />

            <TextView
                android:id="@android:id/text2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?textAppearanceBodyMedium"
                android:textColor="?colorOnSecondaryContainer"
                tools:text="adb · 版本 2.1" />
        </LinearLayout>

        <!-- 杀死 Shizako 酱：一个叉叉就够了，不写文字 -->
        <ImageButton
            android:id="@+id/action_kill"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_action_kill"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_24"
            android:visibility="gone"
            app:tint="?colorOnSecondaryContainer"
            tools:visibility="visible" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
